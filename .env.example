# Copy to .env (which is gitignored) and fill in. Every value here is read by
# docker-compose.yml; none of them belong in a committed file.

# --- Expo / networking -------------------------------------------------------
# Your host machine's LAN address, so Expo Go on a phone can reach the dev
# server and the backend. Re-check when you switch networks.
#   macOS:  ipconfig getifaddr en0
#   Linux:  hostname -I
LAN_IP=192.168.1.17

# --- LLM (flashcard + syllabus generation) -----------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Leave OPENAI_API_KEY empty
# and generation quietly falls back to the offline heuristic, so the app still
# works — it just produces simpler cards.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override only if you're not using OpenAI itself (Azure, OpenRouter, a local
# Ollama at http://ollama:11434/v1, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Text-to-speech (flashcard audio export) ---------------------------------
# A Google Cloud API key with the Text-to-Speech API enabled. Empty disables
# audio export only; the rest of the app is unaffected.
#   https://console.cloud.google.com/apis/credentials
# Restrict the key to the Text-to-Speech API before using it anywhere real.
GOOGLE_TTS_API_KEY=
# IMPORTANT: Google silently falls back to a default voice if this name does
# not exist — a typo gives you working audio in the wrong voice with no error
# anywhere. List the real names before changing it:
#   curl "https://texttospeech.googleapis.com/v1/voices?languageCode=pl-PL" \
#        -H "X-Goog-Api-Key: $GOOGLE_TTS_API_KEY"
# For Polish: Standard-F/G, Wavenet-F/G, and ~30 Chirp3-HD-* voices.
# Standard-F and Wavenet-F currently return identical audio, so Standard is
# the cheaper way to get that voice. Chirp3-HD-* genuinely sound different.
GOOGLE_TTS_VOICE=pl-PL-Standard-F

# --- Admin panel -------------------------------------------------------------
# The single super-admin account, created/updated on every startup.
# PASSWORD_HASH is a hash, never a plaintext password. Generate it with:
#   cd backend-api && dotnet run --no-launch-profile -- hash-password 'your password' | tail -1
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=
